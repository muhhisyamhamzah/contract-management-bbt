# Salin menjadi backend/.env lalu isi. File .env TIDAK PERNAH di-commit.

# Neon, aplikasi: alamat POOLED (ada "-pooler" di host). Awalan diganti menjadi postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:sandi@ep-contoh-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon, migrasi Alembic: alamat DIRECT (tanpa "-pooler") branch main.
DATABASE_URL_MIGRASI=postgresql+psycopg://user:sandi@ep-contoh.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon branch "uji", alamat DIRECT. Hanya dipakai pytest; isinya dihapus setiap uji.
DATABASE_URL_UJI=postgresql+psycopg://user:sandi@ep-contoh-uji.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_MENIT=720
LAMA_KUNCI_DETIK=300

# CORS: alamat frontend, dipisah koma.
ASAL_FRONTEND=http://localhost:5173

# Fase berikutnya (belum dipakai):
# R2_ACCOUNT_ID=  R2_ACCESS_KEY=  R2_SECRET_KEY=  R2_BUCKET=  R2_URL_MENIT=10
# MAKS_UKURAN_BERKAS_MB=25
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_SANDI=  SMTP_PENGIRIM=
